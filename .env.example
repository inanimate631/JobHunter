# PostgreSQL credentials used by docker-compose.yml
POSTGRES_DB=JobHunter
POSTGRES_USER=jobhunter
POSTGRES_PASSWORD=change-this-to-a-long-random-password

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=put-your-telegram-bot-token-here

# Host port mapped to the application container
APP_PORT=8080
